{
  "name": "thumbnail-generator",
  "version": "1.0.0",
  "description": "Turn any URL into a 1200x630 thumbnail, using the page's Open Graph image or a headless Chromium screenshot.",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "dev:client": "tsc -p tsconfig.client.json --watch",
    "build": "tsc -p tsconfig.build.json && npm run build:client",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "thumbnail",
    "open-graph",
    "og-image",
    "screenshot",
    "puppeteer",
    "express",
    "typescript"
  ],
  "author": "Atharv Dange",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atharvdange618/Webpage-Thumbnail-Generator.git"
  },
  "bugs": {
    "url": "https://github.com/atharvdange618/Webpage-Thumbnail-Generator/issues"
  },
  "type": "module",
  "dependencies": {
    "chalk": "^4.1.2",
    "express": "^5.3.0",
    "open-graph-scraper": "^6.12.0",
    "puppeteer-core": "^25.15.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
